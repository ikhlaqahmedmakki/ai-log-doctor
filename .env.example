# Copy this file to .env and fill in real values locally.
# .env is gitignored. Do not commit secrets.

# API key for the model provider. Sent only as a request header.
LLM_API_KEY=your-api-key-here

# Base URL of the chat completions REST API, with no trailing path.
# Example: https://api.openai.com/v1
API_BASE_URL=https://api.example.com/v1

# Incoming Discord webhook that receives new findings.
# Example: https://discord.com/api/webhooks/your-id/your-token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token
